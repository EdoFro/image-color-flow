    "package": "node scripts/empaquetar.mjs",
    "test:distribution": "node tests/distribution.test.mjs",
    "test:projects": "node scripts/ejecutar-pruebas-vista.mjs --projects",
    "test:preview": "node scripts/ejecutar-pruebas-vista.mjs",
    "test:editor": "node scripts/ejecutar-pruebas-vista.mjs --editor",
    "test:highlights": "node scripts/ejecutar-pruebas-vista.mjs --highlights",
    "test:i18n": "node tests/i18n.test.mjs && node scripts/ejecutar-pruebas-vista.mjs --i18n",
    "test:integration": "node tests/integration.test.mjs",
    "test:workflow": "node tests/saving-history.test.mjs && node scripts/ejecutar-pruebas-vista.mjs --workflow",
    "test:canvas": "node tests/canvas-viewport.test.mjs && node scripts/ejecutar-pruebas-vista.mjs --canvas",
    "test:initial": "node tests/initial-wait.test.mjs && node scripts/ejecutar-pruebas-vista.mjs --initial",
    "test:header": "node tests/preferences.test.mjs && node scripts/ejecutar-pruebas-vista.mjs --header",
    "test:blank": "node tests/blank-base.test.mjs && node scripts/ejecutar-pruebas-vista.mjs --blank"
  }
}
